
# Real driving distances (optional — falls back to estimates without it)
# Enable "Distance Matrix API" in Google Cloud Console, ~$5/1000 lookups, $200/mo free credit
GOOGLE_MAPS_API_KEY=

# Live Google reviews (optional — falls back to static reviews if unset)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Alternative to GOOGLE_PLACE_ID: looks the listing up by name
GOOGLE_PLACE_QUERY=
